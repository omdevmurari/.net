@model p6.Models.Product

@{
    Layout = null;
}
<div>
    <h1>Product Details</h1>

    <h2>@Model.Name</h2>
    
    <h3>@Model.Category</h3>
    <h3>@Model.Price</h3>

    <p>@Model.Description</p>

    <img src="@Model.ImageUrl" width="200" height="200"/>

    <p>@Html.ActionLink("Back to Main Page", "index")</p>
</div>